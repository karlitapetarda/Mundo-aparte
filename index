* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-image: url(./contenido/kakota.jpg);
  font-family: 'Gochi Hand', cursive;
  font-size: 17px;
  color: #fff;
}

#web {
  max-width: 1200px;
  margin: 0 auto;
}

a {
  color: #fff;
  text-decoration: none;
}

#cabecera {
  background: #000;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 170px;
  padding: 0 20px;
  margin-bottom: 10px;
}


.titulo {
  flex: 1;
  text-align: center;
  margin-right: 140px;
}

.titulo h1 {
  font-family: 'Rubik Wet Paint', cursive;
  font-size: 72px;
  font-weight: normal;
  color: #ff2f9e;
}

.titulo p {
  font-size: 28px;
}

.lema {
  color: #ff2f9e;
  font-size: 24px;
  transform: rotate(-12deg);
  text-align: left;
}

.retrato {
  width: 250px;
  height: 140px;
  border: none;
  background: none;
}

#cuerpo {
  display: flex;
  gap: 10px;
  align-items: flex-start;
}

#izquierda, #derecha {
  width: 200px;
  flex-shrink: 0;
}

#centro {
  flex: 1;
  background: #000;
  border: 2px solid #ff2f9e;
  padding: 20px;
}

.caja {
  background: #000;
  border: 2px solid #ff2f9e;
  padding: 12px;
  margin-bottom: 10px;
}

.caja h3 {
  color: #ff2f9e;
  font-weight: normal;
  font-size: 20px;
  margin-bottom: 8px;
}

nav.caja a {
  display: block;
  font-size: 20px;
  padding: 6px 0;
  border-bottom: 1px solid #ff2f9e;
}

nav.caja a:last-child {
  border-bottom: none;
}

nav.caja a:hover {
  color: #ff2f9e;
}

.fecha {
  color: #ff2f9e;
  font-size: 14px;
  margin-top: 8px;
}

.caja p {
  font-size: 16px;
}

.musica {
  display: flex;
  align-items: center;
  gap: 10px;
}

.ipod {
  width: 50px;
  height: 80px;
  background: #ff2f9e;
  border-radius: 8px;
  flex-shrink: 0;
}

#contador {
  display: flex;
  gap: 3px;
}

#contador span {
  border: 1px solid #fff;
  padding: 2px 5px;
  font-family: monospace;
  font-size: 18px;
}

.chica {
  display: flex;
  align-items: center;
  gap: 8px;
}

.chica p {
  color: #ff2f9e;
}

.gato {
  width: 90px;
  height: 90px;
  flex-shrink: 0;
}

.obras {
  border-style: dashed;
  text-align: center;
  color: #ff2f9e;
}

#centro h2 {
  color: #ff2f9e;
  font-weight: normal;
  font-size: 32px;
  margin-bottom: 15px;
}

#centro p {
  max-width: 480px;
  margin-bottom: 10px;
}

.sello {
  float: right;
  margin-top: -150px;
  background: #000;
  border: 2px solid #fff;
  padding: 10px 14px;
  font-size: 26px;
  transform: translateX(12px) rotate(-10deg);
}

#galeria,
#musica-grid {
  clear: both;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  margin-top: 25px;
}

figure .foto {
  width: 100%;
  aspect-ratio: 4 / 3;
}

#musica-grid figure {
  min-width: 0;
}

figure .musica-portada {
  aspect-ratio: 1 / 1;
  cursor: default;
}

.pie-musica {
  margin-top: 6px;
}

.titulo-cancion {
  display: block;
  width: 100%;
  color: #ff2f9e;
  font-family: inherit;
  font-size: 19px;
  overflow-wrap: anywhere;
  text-decoration: none;
}

.titulo-cancion[href]:hover {
  text-decoration: underline;
}

.titulo-cancion:not([href]) {
  opacity: 0.8;
}

.estado-cancion {
  display: block;
  margin-top: 5px;
  color: #bbb;
  font-size: 13px;
  line-height: 1.2;
}

figcaption {
  color: #ff2f9e;
  margin-top: 6px;
  font-size: 19px;
}

.gracias {
  text-align: center;
  color: #ff2f9e;
  margin-top: 25px;
  max-width: none !important;
}

.foto {
  background: #111;
  border: 2px solid #666;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  cursor: pointer;
}

.foto:empty::before {
  content: '+';
  color: #ff2f9e;
  font-size: 32px;
}

.foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.mini {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.mini .foto {
  aspect-ratio: 1 / 1;
}

#derecha ul {
  list-style: none;
}

#derecha li {
  font-size: 18px;
  color: #ff2f9e;
  padding: 2px 0;
}

#derecha li::before {
  content: '\2022  ';
}

.mariposa {
  width: 100px;
  height: 100px;
  flex-shrink: 0;
}

.ranking {
  display: block;
  background: #fff;
  color: #00c;
  border: 2px solid #00c;
  text-align: center;
  font-family: Arial, sans-serif;
  font-size: 11px;
  padding: 3px;
}

.ranking b {
  font-size: 20px;
}

@media (max-width: 900px) {
  #cuerpo {
    flex-direction: column;
  }

  #izquierda, #derecha {
    width: 100%;
  }

  .titulo h1 {
    font-size: 40px;
  }

  .retrato, .lema {
    display: none;
  }

  #galeria,
  #musica-grid {
    grid-template-columns: 1fr 1fr;
  }
}
